# Copy to .env and fill in. .env is ignored by git: never commit real keys.

# --- Amazon Bedrock (the models) ---------------------------------------------------------
# Use ONE of these, made for CrewPay only (IAM user paypal-crewpay-bedrock, policy in
# deploy/paypal-crewpay-bedrock-policy.json). The default AWS profile is never used, no IAM role.
#   a) an API key for Amazon Bedrock on that user, simplest for Render
CREWPAY_BEDROCK_API_KEY=
#   b) an access key of that same user
CREWPAY_AWS_ACCESS_KEY_ID=
CREWPAY_AWS_SECRET_ACCESS_KEY=
#   c) a profile in ~/.aws named paypal-crewpay ("default" is refused)
CREWPAY_AWS_PROFILE=
CREWPAY_BEDROCK_REGION=ap-southeast-2
CREWPAY_ADVISOR_MODEL=global.amazon.nova-2-lite-v1:0
CREWPAY_ROUTER_MODEL=amazon.nova-micro-v1:0
CREWPAY_WRITER_MODEL=global.amazon.nova-2-lite-v1:0
CREWPAY_VISION_MODEL=global.amazon.nova-2-lite-v1:0

# --- PayPal (sandbox only) ---------------------------------------------------------------
# developer.paypal.com > Apps & Credentials > Sandbox > the app paypal-crewpay-sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
# Webhook ID from the same app, once the webhook URL is added (optional on a laptop)
PAYPAL_WEBHOOK_ID=
# Every payout goes to this sandbox personal account (Sandbox > Accounts). Leave empty to pay
# each crew member's own address, which PayPal keeps as unclaimed.
PAYPAL_SANDBOX_RECEIVER=
# Where the console is served, so PayPal returns a payer there after an approve link
# (Render sets RENDER_EXTERNAL_URL itself)
CREWPAY_PUBLIC_URL=
CREWPAY_CURRENCY=USD
# Costs are in rupees; payouts are paid at this demo rate
CREWPAY_FX_INR_PER_USD=84
# A payment above this (in CREWPAY_CURRENCY) waits for a second approver to release it
CREWPAY_PAY_CAP=500

# --- The app -----------------------------------------------------------------------------
CREWPAY_STAGE=dev
# Run the demo week on today's dates
CREWPAY_LIVE_CLOCK=false
# Model-backed requests allowed per day, to protect the credits
CREWPAY_DAILY_ASKS=300
# Background loop (callouts, escalation, payment status), in seconds; 0 turns it off
CREWPAY_TICKER_SECONDS=60
# Append every model call's token use to this JSON-lines file (optional)
CREWPAY_USAGE_LOG=
# Optional prompt-injection classifier endpoint
PROMPT_GUARD_URL=
PROMPT_GUARD_TOKEN=

# --- Signing in ------------------------------------------------------------------------------
# One password every demo account signs in with (give it to judges in the Devpost testing
# instructions). Leave empty on a laptop to sign in without one.
CREWPAY_DEMO_PASSWORD=
# Optional: keeps people signed in across restarts; any long random string
CREWPAY_SESSION_SECRET=

# --- Alexa (optional) ------------------------------------------------------------------------
# The CrewPay skill's id from the Alexa developer console; requests for other skills are refused
CREWPAY_ALEXA_SKILL_ID=
# Account linking: the client id and secret entered on the skill's Account linking page
CREWPAY_ALEXA_CLIENT_ID=paypal-crewpay-alexa
CREWPAY_ALEXA_CLIENT_SECRET=
# The Alexa Redirect URLs that page lists, comma-separated
CREWPAY_ALEXA_REDIRECT_URLS=
# The skill's Alexa Skill Messaging credentials (Permissions page), for the Echo to chime
CREWPAY_ALEXA_MESSAGING_CLIENT_ID=
CREWPAY_ALEXA_MESSAGING_CLIENT_SECRET=
# development until the skill is certified
CREWPAY_ALEXA_EVENTS_STAGE=development
