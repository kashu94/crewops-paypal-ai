# Copy to .env and fill in. .env is ignored by git: never commit real keys.

# --- Amazon Bedrock (the models) ---------------------------------------------------------
# Use ONE of these, made for CrewPay only. The machine's default AWS profile is never used.
#   a) a Bedrock API key (Bedrock console > API keys), simplest for Render
CREWPAY_BEDROCK_API_KEY=
#   b) access keys of an IAM user that may only call bedrock:InvokeModel
CREWPAY_AWS_ACCESS_KEY_ID=
CREWPAY_AWS_SECRET_ACCESS_KEY=
#   c) a named profile in ~/.aws created for CrewPay ("default" is refused)
CREWPAY_AWS_PROFILE=
CREWPAY_BEDROCK_REGION=us-east-1
CREWPAY_ADVISOR_MODEL=us.amazon.nova-2-lite-v1:0
CREWPAY_ROUTER_MODEL=us.amazon.nova-micro-v1:0
CREWPAY_WRITER_MODEL=us.amazon.nova-2-lite-v1:0
CREWPAY_VISION_MODEL=us.amazon.nova-2-lite-v1:0

# --- PayPal (sandbox only) ---------------------------------------------------------------
# developer.paypal.com > Apps & Credentials > Sandbox > your CrewPay app
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
# Webhook ID from the same app, once the webhook URL is added (optional on a laptop)
PAYPAL_WEBHOOK_ID=
CREWPAY_CURRENCY=USD
# The most one approved plan may pay out; more is held for finance
CREWPAY_PAY_CAP=2500

# --- The app -----------------------------------------------------------------------------
CREWPAY_STAGE=dev
# Run the demo week on today's dates
CREWPAY_LIVE_CLOCK=false
# Model-backed requests allowed per day, to protect the credits
CREWPAY_DAILY_ASKS=300
# Background loop (callouts, escalation, payment status), in seconds; 0 turns it off
CREWPAY_TICKER_SECONDS=60
# Append every model call's token use to this JSON-lines file (optional)
CREWPAY_USAGE_LOG=
# Optional prompt-injection classifier endpoint
PROMPT_GUARD_URL=
PROMPT_GUARD_TOKEN=
